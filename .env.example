# 开发环境配置
PORT=3001

# 加密配置 (用于加密传输私钥)
# 请使用32个字符的字符串作为加密密钥        
# 在生产环境中，请使用强随机生成的密钥并妥善保管
ENCRYPTION_KEY=xxx

# 开发环境标识
NODE_ENV=development

# ---- 限流配置（控制每隔多久能发多少个请求到 Sui 链上） ----
# RATE_LIMIT_TOKENS: 一个周期内最多发多少个请求，默认 500。
#   比如设成 500 就是每 30 秒最多发 500 个请求。
# RATE_LIMIT_WINDOW_MS: 这个周期多长（毫秒），默认 30000（30 秒）。
#   举例：默认 500 / 30秒 ≈ 每秒发 16 个请求。
#   如果跑私有 RPC，可以加大。如果跑公共 RPC，这个值没意义，服务端会拦你。
RATE_LIMIT_TOKENS=500
RATE_LIMIT_WINDOW_MS=30000

# ---- GraphQL 端点（可选，不填则使用 Sui 公共端点） ----
# MAINNET_GRAPHQL_URL=https://graphql.mainnet.sui.io/graphql
# TESTNET_GRAPHQL_URL=https://graphql.testnet.sui.io/graphql
# DEVNET_GRAPHQL_URL=https://graphql.devnet.sui.io/graphql
# LOCALNET_GRAPHQL_URL=http://127.0.0.1:9125/graphql